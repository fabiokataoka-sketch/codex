{
  "$description": "Wakaru design tokens — fonte legível por máquina (Figma, Style Dictionary). Espelha css/tokens.css, que por sua vez espelha o app em produção (wakaruapp.app).",
  "color": {
    "red": {
      "100": "#F7E2DC",
      "300": "#D9705F",
      "500": "#B22C1B",
      "600": "#9C2414",
      "700": "#8E2214",
      "900": "#2A1109"
    },
    "neutral": {
      "ink": "#241610",
      "ink600": "#5A4137",
      "line": "#E3D9C9",
      "card": "#FFFDF8",
      "cream": "#FFF6EC",
      "paper": "#F6F2EA"
    },
    "ornament": {
      "gold": "#B08432"
    },
    "status": {
      "$comment": "Dois degraus de urgência, não três: urgent e soon dividem o mesmo vermelho de propósito, e a distinção fica na cópia. Não existe amarelo.",
      "urgent": "{color.red.700}",
      "urgentBg": "{color.red.100}",
      "soon": "{color.red.700}",
      "soonBg": "{color.red.100}",
      "ok": "#2F6B52",
      "okBg": "#E0EFE7",
      "info": "{color.neutral.ink600}",
      "danger": "{color.red.700}"
    },
    "semantic": {
      "$comment": "Papel primeiro, e só papel: não existe tema escuro.",
      "bg": "{color.neutral.paper}",
      "surface": "{color.neutral.card}",
      "surfaceHover": "{color.neutral.cream}",
      "border": "{color.neutral.line}",
      "text": "{color.neutral.ink}",
      "textMuted": "{color.neutral.ink600}",
      "accent": "{color.red.500}",
      "accentHover": "{color.red.700}",
      "accentSoft": "{color.red.100}",
      "accentContrast": "{color.neutral.cream}",
      "focusRing": "{color.ornament.gold}",
      "cameraBg": "{color.red.900}",
      "cameraInk": "{color.neutral.cream}"
    }
  },
  "font": {
    "display": "Archivo, 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif",
    "body": "'Zen Kaku Gothic New', 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif",
    "friendly": "'Zen Maru Gothic', 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif",
    "jp": "'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic', sans-serif",
    "jpOld": "'Zen Old Mincho', 'Noto Sans JP', serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
  },
  "fontSize": {
    "$comment": "px absolutos por escolha: o público ajusta o zoom do sistema e a escala precisa ser previsível. 17px é o tamanho do sistema.",
    "label": "11px",
    "xs": "13px",
    "sm": "14px",
    "md": "17px",
    "lg": "18px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "28px",
    "4xl": "40px"
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "extrabold": 800
  },
  "lineHeight": {
    "none": 1,
    "tight": 1.25,
    "snug": 1.5,
    "normal": 1.65,
    "jp": 1.7,
    "loose": 2
  },
  "letterSpacing": {
    "normal": "0",
    "label": "0.12em"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "7": "2rem",
    "8": "3rem",
    "9": "4rem",
    "10": "5rem"
  },
  "radius": {
    "sm": "8px",
    "md": "10px",
    "lg": "12px",
    "surface": "16px",
    "sheet": "24px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px color-mix(in oklab, #241610 10%, transparent)",
    "md": "0 8px 24px color-mix(in oklab, #241610 12%, transparent)",
    "lg": "0 20px 50px color-mix(in oklab, #241610 18%, transparent)",
    "hero": "0 30px 60px -26px rgba(60, 8, 0, 0.65)",
    "action": "0 14px 30px -16px rgba(120, 20, 0, 0.65)",
    "up": "0 -8px 24px color-mix(in oklab, #241610 10%, transparent)"
  },
  "motion": {
    "durationFast": "150ms",
    "durationBase": "200ms",
    "durationSlow": "240ms",
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)"
  },
  "tapTarget": {
    "$comment": "Mínimo de 44px em tudo que é tocável.",
    "min": "44px",
    "lg": "56px",
    "action": "68px",
    "nav": "72px"
  },
  "layout": {
    "containerRead": "660px",
    "containerMax": "72rem",
    "navHeight": "calc(72px + 1px + env(safe-area-inset-bottom))"
  }
}
