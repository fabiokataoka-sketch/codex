{
  "$description": "Wakaru design tokens — machine-readable source (Figma sync, Style Dictionary). Mirrors css/tokens.css.",
  "color": {
    "orange": {
      "100": "#FFE3D1",
      "200": "#FFC0A3",
      "300": "#FF9A66",
      "400": "#FF6F2E",
      "500": "#FF4D00",
      "600": "#D64000",
      "700": "#A83200",
      "800": "#7A2400"
    },
    "neutral": {
      "ink": "#111110",
      "ink900": "#171716",
      "ink800": "#1D1D1B",
      "ink700": "#262624",
      "ink600": "#333331",
      "ink500": "#4A4A47",
      "gray400": "#75756F",
      "gray300": "#A3A39C",
      "gray200": "#CFCFC8",
      "gray100": "#E9E9E3",
      "paper": "#FAF8F2",
      "white": "#FFFFFF"
    },
    "status": {
      "urgent": "{color.orange.500}",
      "soon": "#FFB020",
      "ok": "#3DC97B",
      "info": "{color.neutral.gray300}",
      "danger": "#FF3B30"
    },
    "semantic": {
      "dark": {
        "bg": "{color.neutral.ink}",
        "surface": "{color.neutral.ink900}",
        "surfaceRaised": "{color.neutral.ink800}",
        "border": "{color.neutral.ink600}",
        "text": "{color.neutral.paper}",
        "textMuted": "{color.neutral.gray300}",
        "accent": "{color.orange.500}",
        "accentContrast": "{color.neutral.ink}"
      },
      "paper": {
        "bg": "{color.neutral.paper}",
        "surface": "{color.neutral.white}",
        "border": "{color.neutral.gray200}",
        "text": "{color.neutral.ink}",
        "textMuted": "{color.neutral.ink500}",
        "accent": "{color.orange.600}",
        "accentContrast": "{color.neutral.white}"
      }
    }
  },
  "font": {
    "display": "Space Grotesk",
    "body": "Inter",
    "mono": "Space Mono",
    "jp": "Noto Sans JP"
  },
  "fontSize": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "clamp(1.25rem, 1.1rem + 0.7vw, 1.5rem)",
    "2xl": "clamp(1.5rem, 1.2rem + 1.4vw, 2.125rem)",
    "3xl": "clamp(1.875rem, 1.4rem + 2.2vw, 3.125rem)",
    "4xl": "clamp(2.5rem, 1.7rem + 4vw, 4.75rem)",
    "hero": "clamp(3rem, 1.8rem + 7vw, 7.5rem)"
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "9": "6rem",
    "10": "8rem"
  },
  "radius": {
    "sm": "6px",
    "md": "12px",
    "device": "24px",
    "pill": "999px"
  },
  "motion": {
    "durationFast": "150ms",
    "durationBase": "250ms",
    "durationSlow": "500ms",
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
