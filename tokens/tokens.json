{
  "$description": "AI Lab Global design tokens — machine-readable source of truth. Mirrors css/tokens.css.",
  "color": {
    "lime": {
      "100": "#F2FFC2",
      "200": "#E5FF85",
      "300": "#DCFF57",
      "400": "#D2FF2E",
      "500": "#C6FF00",
      "600": "#A3D600",
      "700": "#7FA800",
      "800": "#5C7A00"
    },
    "carbon": {
      "black": "#0A0A0B",
      "900": "#101113",
      "800": "#16181B",
      "700": "#1E2124",
      "600": "#2A2E32",
      "500": "#3C4147"
    },
    "gray": {
      "400": "#6B7178",
      "300": "#9AA0A6",
      "200": "#C7CBD0",
      "100": "#E8EAEC"
    },
    "offwhite": "#F4F5F3",
    "white": "#FFFFFF",
    "status": {
      "success": "#3DDC84",
      "warning": "#FFC53D",
      "danger": "#FF4D4F",
      "info": "#4DA6FF"
    },
    "gold": "#D8B24A"
  },
  "font": {
    "display": "Archivo",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "black": 900
  },
  "letterSpacing": {
    "tight": "-0.03em",
    "normal": "0",
    "wide": "0.08em",
    "wider": "0.18em"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "128px"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "6px",
    "lg": "12px",
    "pill": "999px"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "250ms",
      "slow": "450ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  }
}
