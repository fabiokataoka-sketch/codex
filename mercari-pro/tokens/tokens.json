{
  "$description": "Mercari Pro design tokens — machine-readable source of truth. Mirrors mercari-pro/css/tokens.css.",
  "$prefix": { "css": "--mp-", "primitive": "--mp-c-", "semantic": "--mp-t-" },
  "color": {
    "red": {
      "$note": "500 is Mercari's hero red and only clears 3.99:1 against white — brand use only. 600 is the action red (5.0:1 either direction) and carries all text and filled controls.",
      "50": "#FFF0F1",
      "100": "#FFDADC",
      "200": "#FFB0B4",
      "300": "#FF7B82",
      "400": "#FF3D47",
      "500": "#FF0211",
      "600": "#E00010",
      "700": "#B8000D",
      "800": "#8A000A",
      "900": "#5C0007"
    },
    "blue": {
      "$note": "Mercari Blue (400) leads the data/secondary voice. Never a primary action.",
      "50": "#EAF8FF",
      "100": "#CDEFFF",
      "200": "#A6E3FF",
      "300": "#7AD6FF",
      "400": "#4DC9FF",
      "500": "#1FB2F0",
      "600": "#0B90C9",
      "700": "#0A6F9B",
      "800": "#08526F"
    },
    "gray": {
      "$note": "Anchored on Mercari Black #222222 (900).",
      "25": "#FAFAFB",
      "50": "#F5F5F7",
      "100": "#EEEEF0",
      "200": "#E2E2E5",
      "300": "#C9C9CE",
      "400": "#A0A0A7",
      "500": "#74747B",
      "600": "#55555C",
      "700": "#3B3B41",
      "800": "#2C2C31",
      "900": "#222222",
      "950": "#171719"
    },
    "white": "#FFFFFF",
    "black": "#0E0E10",
    "status": {
      "green": { "50": "#E7F7F0", "500": "#12B981", "600": "#0E9F6E", "700": "#0A7A54" },
      "amber": { "50": "#FFF6E5", "500": "#F59E0B", "600": "#C97A05", "700": "#93590A" },
      "violet": { "50": "#F1EDFE", "500": "#7C5CE0", "600": "#6544C9" }
    }
  },
  "theme": {
    "light": {
      "bg": "color.white",
      "bgSunken": "color.gray.50",
      "surface": "color.white",
      "surfaceAlt": "color.gray.25",
      "surfaceHover": "color.gray.50",
      "surfaceSelected": "color.red.50",
      "inverse": "color.gray.900",
      "line": "color.gray.200",
      "lineSoft": "color.gray.100",
      "lineStrong": "color.gray.300",
      "text": "color.gray.900",
      "textMuted": "color.gray.500",
      "textFaint": "color.gray.400",
      "accent": "color.red.500",
      "action": "color.red.600",
      "actionHover": "color.red.700",
      "onAction": "color.white",
      "data": "color.blue.600",
      "success": "color.status.green.600",
      "warning": "color.status.amber.700",
      "critical": "color.red.700",
      "info": "color.status.violet.600",
      "focus": "color.blue.600"
    },
    "dark": {
      "$note": "The accent/action pair inverts: on near-black the hero red carries text (5.3:1) and the darker action red does not.",
      "bg": "color.black",
      "bgSunken": "#08080A",
      "surface": "color.gray.950",
      "surfaceAlt": "#131315",
      "surfaceHover": "color.gray.800",
      "surfaceSelected": "rgba(255,2,17,0.14)",
      "inverse": "color.white",
      "line": "#2A2A2F",
      "lineSoft": "#1F1F23",
      "lineStrong": "#3D3D44",
      "text": "#F4F4F5",
      "textMuted": "color.gray.400",
      "textFaint": "color.gray.500",
      "accent": "color.red.500",
      "action": "color.red.500",
      "actionHover": "color.red.400",
      "onAction": "color.white",
      "data": "color.blue.400",
      "success": "color.status.green.500",
      "warning": "color.status.amber.500",
      "critical": "color.red.400",
      "info": "color.status.violet.500",
      "focus": "color.blue.400"
    }
  },
  "font": {
    "display": "Inter Tight",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 }
  },
  "type": {
    "display1": "clamp(3.25rem, 8.5vw, 9rem)",
    "display2": "clamp(2.5rem, 5.6vw, 5.5rem)",
    "h1": "clamp(2rem, 3.4vw, 3.25rem)",
    "h2": "clamp(1.5rem, 2.2vw, 2.125rem)",
    "h3": "1.375rem",
    "h4": "1.125rem",
    "lg": "1.0625rem",
    "md": "0.9375rem",
    "sm": "0.8125rem",
    "xs": "0.75rem",
    "2xs": "0.6875rem"
  },
  "tracking": {
    "display": "-0.035em",
    "heading": "-0.02em",
    "normal": "-0.006em",
    "wide": "0.02em",
    "label": "0.11em"
  },
  "leading": { "tight": 1.05, "snug": 1.25, "normal": 1.5, "relaxed": 1.65 },
  "space": {
    "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem",
    "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem",
    "20": "5rem", "24": "6rem", "32": "8rem"
  },
  "radius": { "xs": "4px", "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "pill": "999px" },
  "shadow": {
    "1": "0 1px 2px rgba(14,14,16,0.06)",
    "2": "0 4px 16px -4px rgba(14,14,16,0.10)",
    "3": "0 18px 48px -12px rgba(14,14,16,0.18)",
    "pop": "0 24px 64px -16px rgba(14,14,16,0.28)"
  },
  "motion": {
    "duration": { "fast": "140ms", "base": "220ms", "slow": "420ms", "page": "640ms" },
    "ease": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in": "cubic-bezier(0.5, 0, 0.75, 0)"
    }
  },
  "layout": {
    "container": "1440px",
    "measure": "68ch",
    "gutter": "clamp(1.25rem, 4vw, 4rem)",
    "sidebar": "264px",
    "topbar": "60px"
  },
  "density": {
    "comfortable": { "rowHeight": "52px", "controlHeight": "38px", "cellPadY": "0.75rem", "cellPadX": "1rem" },
    "compact": { "rowHeight": "40px", "controlHeight": "32px", "cellPadY": "0.5rem", "cellPadX": "0.75rem" }
  }
}
